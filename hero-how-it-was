// src/components/Hero.jsx
import Ticker from '../components/Ticker.jsx';

export default function Hero({ onViewProjects }) {
  return (
    <section className="text-text">
      {/* added horizontal padding at each breakpoint */}
      <div className="container px-4 sm:px-6 lg:px-8 py-10 md:py-20">
        {/* stronger horizontal gaps between columns */}
        <div className="grid md:grid-cols-2 items-center gap-y-12 gap-x-8 md:gap-x-14 lg:gap-x-24">
          {/* LEFT — stacked with uniform rhythm; add right padding to push away from blob */}
          <div className="flex flex-col gap-6 md:gap-8 md:pr-10 xl:pr-20 max-w-[46rem]">
            <p
              className="text-accent font-semibold tracking-wide animate-fade-up"
              style={{ animationDelay: '60ms' }}
            >
              Machine Learning Engineer
            </p>

            <h1
              className="
                font-extrabold tracking-tight leading-[1.15]
                text-3xl sm:text-4xl md:text-6xl
                animate-fade-up
              "
              style={{ animationDelay: '120ms' }}
            >
              <span className="animated-gradient">I build reliable ML systems</span>
              <span> — NLP, CV &amp; IoT.</span>
            </h1>

            <p
              className="text-subtext max-w-prose text-[15px] sm:text-base animate-fade-up"
              style={{ animationDelay: '180ms' }}
            >
              From PyTorch training to MLOps, Kafka streaming, and clean MERN dashboards.
              Explore selected projects with metrics, diagrams, and case studies.
            </p>

            {/* CTAs */}
            <div className="flex flex-col sm:flex-row gap-3 sm:gap-4">
              <button
                className="
                  btn btn-primary btn-lg w-full sm:w-auto
                  transition-transform duration-150
                  will-change-transform
                  hover:-translate-y-[1px] active:translate-y-0
                  animate-fade-up
                "
                style={{ animationDelay: '240ms' }}
                onClick={onViewProjects}
              >
                View Projects
              </button>

              <a
                className="
                  btn btn-ghost btn-lg w-full sm:w-auto
                  transition-colors duration-150
                  hover:bg-[color-mix(in_srgb,var(--bg-elevated)_85%,transparent)]
                  animate-fade-up
                "
                style={{ animationDelay: '300ms' }}
                href="/cv.pdf"
                target="_blank"
                rel="noreferrer"
              >
                Download CV
              </a>
            </div>

            {/* Scrolling line of highlights — mobile only */}
            <Ticker
              className="mt-6 md:mt-8 md:hidden"
              speed={90}
              gap={14}
              items={[
                '10+ repos',
                '3 production demos',
                'MERN • PyTorch • Spark',
                'FastAPI • Kafka',
                'React • Vite • Docker',
              ]}
            />

            {/* Mini-stats (mobile only) */}
            <div className="grid grid-cols-2 gap-3 md:hidden">
              {[
                ['Best Acc.', '95.4%'],
                ['IoT F1', '0.87'],
                ['Prod. demos', '3'],
                ['Years', '2+'],
              ].map(([k, v], i) => (
                <div
                  key={k}
                  className="card p-3 animate-pop-in"
                  style={{ animationDelay: `${420 + i * 60}ms` }}
                >
                  <div className="text-subtext text-xs">{k}</div>
                  <div className="text-lg font-semibold">{v}</div>
                </div>
              ))}
            </div>
          </div>

          {/* RIGHT — visual; add a little left padding so it never kisses the container edge */}
          <div className="hidden md:flex justify-end md:pl-4 lg:pl-8">
            <div className="w-full md:max-w-[380px] lg:max-w-[440px] xl:max-w-[500px]">
              <div className="hero-blob relative overflow-hidden rounded-2xl border border-base shadow-xl animate-float-slow">
                {/* base gradient */}
                <div
                  className="absolute inset-0"
                  style={{
                    background:
                      'linear-gradient(135deg, var(--bg-card), var(--bg-elevated))',
                  }}
                />
                {/* soft colored blobs */}
                <div
                  className="absolute inset-0"
                  style={{
                    backgroundImage: `
                      radial-gradient(60% 45% at 80% 20%, color-mix(in srgb, var(--accent) 28%, transparent), transparent 65%),
                      radial-gradient(60% 45% at 20% 80%, color-mix(in srgb, var(--accent-hi) 28%, transparent), transparent 65%)
                    `,
                  }}
                />
                {/* faint grid overlay */}
                <div
                  className="absolute inset-0 opacity-50"
                  style={{
                    backgroundImage:
                      'repeating-linear-gradient(0deg, transparent 0 24px, var(--grid) 24px 26px)',
                  }}
                />
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Local animation styles */}
      <style>{`
        @keyframes fadeUp {
          from { opacity: 0; transform: translateY(10px); }
          to   { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-up { animation: fadeUp .45s ease forwards; opacity: 0; }

        @keyframes popIn {
          0%   { opacity: 0; transform: scale(.98); }
          100% { opacity: 1; transform: scale(1); }
        }
        .animate-pop-in { animation: popIn .35s ease forwards; opacity: 0; }

        @keyframes floatSlow {
          0%, 100% { transform: translateY(0); }
          50%      { transform: translateY(-6px); }
        }
        .animate-float-slow {
          animation: floatSlow 8s ease-in-out infinite;
          will-change: transform;
        }

        .animated-gradient{
          background: linear-gradient(90deg, var(--accent), var(--accent-hi));
          background-size: 200% 200%;
          -webkit-background-clip: text;
          background-clip: text;
          color: transparent;
          animation: gradientShift 8s ease-in-out infinite;
        }
        @keyframes gradientShift{
          0%{ background-position: 0% 50%; }
          50%{ background-position: 100% 50%; }
          100%{ background-position: 0% 50%; }
        }
      `}</style>
    </section>
  );
}
